%info
Measure the receiving rate of a DPDK port using FastClick.

Receives packets on a single DPDK port and reports the average link rate
(`RESULT-RX`) and hardware-dropped packets (`RESULT-DROPPED`) using an
AverageCounter element.

Usage:
```bash
%%import@dut fastclick-rcv NT=4
```

%config
accept_zero={DROPPED}

%variables
//Number of receive threads
NT=1
//Number of RX descriptors
NDESC=256
//Number of memory buffers
NB_MBUF=65536

%late_variables
AVGCNT=IF($NT > 1,AverageCounterMP,AverageCounter)

%script deps=fastclick sudo=true python-inline
click --dpdk -l 0-$(($NT - 1)) -- RCV_CONFIG

%file RCV_CONFIG
DPDKInfo(NB_MBUF $NB_MBUF)
    fd :: FromDPDKDevice(${self:0:pci}, MAC ${client:0:mac}, MAXTHREADS $NT, VERBOSE 99, NDESC $NDESC)
    -> avg :: $AVGCNT
    -> Discard

DriverManager(
    wait 1s,
    write avg.reset,
    wait,
    print "RESULT-DROPPED $(fd.hw_dropped)",
    print "AVG0 $(avg.link_rate) COUNT $(avg.count)",
    print "RESULT-RX $(avg.link_rate)")
