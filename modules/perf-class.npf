%info
Advanced performance profiling using perf record and the perf-class tool.

Records CPU cycles with `perf record`, then uses the perf-class Python program
(<https://github.com/tbarbette/perf-class>) to aggregate symbols into categories
using a classification map (dictionary). Outputs `RESULT-PERF-<category>` with
the percentage of time spent in each class.

Usage:
```bash
%%import@dut perf-class PERF_TIME=10 PERF_MIN=2
```

%config
graph_result_as_variable+={PERF-(.*):Perf}

%variables
//Extra options for perf record
PERF_OPT= -g --call-graph dwarf
//Recording duration in seconds
PERF_TIME?=4
//Hardware event to record
PERF_EVENT=cycles
//Minimum percentage to report
PERF_MIN=1
//Path to the classification map file
PERF_CLASS_MAP=EXPAND($NPF_ROOT_PATH/libs/perf/kernel.map)
//Maximum call stack depth
PERF_STACK_MAX=8
//Sampling frequency in Hz
PERF_FREQ=1000
//Extra options for perf-class, e.g. --map path/to/file.map to add your own map
PERF_CLASS_OPT?=
//Extra options for perf script
PERF_SCRIPT_OPT?=

%late_variables
//Suffix of the perf data files, to run multiple instances
PERF_PREFIX?=

%-nolibs:sendfile ../libs/perf/

%script sudo=true autokill=false deps=perf-class nokill=true title=perf_measurement
trap : INT
sh script.sh ${PERF_PREFIX}

%file script.sh
echo "Launching perf record..."
trap : INT
PREFIX=$1
echo "Recording perf..."
perf record -r 80 -F $PERF_FREQ -a $PERF_OPT -o perf${PREFIX}.data -e $PERF_EVENT sleep $PERF_TIME
chmod +r perf${PREFIX}.data
echo "Record finished"

%exit
echo "Running perf script..."
sudo perf script ${PERF_SCRIPT_OPT} -i perf${PREFIX}.data > perf${PREFIX}.script
echo "Running perf class..."
python3 ${NPF_BUILD_ROOT}/perf-class/perf_class/perf_class.py perf${PERF_PREFIX}.script --map ${PERF_CLASS_MAP} --min ${PERF_MIN} --stack-max ${PERF_STACK_MAX} --show-failed ${PERF_CLASS_OPT} > perf${PERF_PREFIX}.list
echo "Script finished"
echo "NOTE: If the number of match is not near 100 percent, add your own perf-class map of events ! Use PERF_CLASS_OPT=--map path/to/file.map"
cat perf${PERF_PREFIX}.list | while read line; do
    sym=$(echo $line | cut -d';' -f1 | xargs)
    pc=$(echo $line | cut -d';' -f2 | xargs | grep -oE '[0-9.]*' )
    roundpc=$(echo $pc | grep -oE '[0-9]*' | head -n 1)
    if [ "$sym" != "" ] ; then
        echo "RESULT-PERF${PERF_PREFIX}-$(echo $sym | sed 's/[^0-9a-zA-Z_~()]*//g' ) $pc"
    fi
done
echo "Finished"
