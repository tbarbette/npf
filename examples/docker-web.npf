%info
HTTP page fetch timings (curl) against either a synthetic nginx server or a list of real websites.

Default (synthetic): the `server` role runs nginx and serves a file of FSIZE KB, the `client` fetches it.
With --tags real: no server is needed, the client fetches each URL of docker-testbed/sites.txt (one per line).
Use another list with --variables 'URL=FILE(/path/to/list.txt)', or a few URLs with --variables 'URL={https://a.org/,https://b.org/}'.

With --tags netem the client link is delayed by DELAY ms (on the way out, so it adds to every round trip) and the
download is limited to RATE (on the way in, through an ifb device, or by policing where ifb is not available, as in
Docker Desktop). Needs NET_ADMIN and tc.

Testbed (see examples/docker-testbed/README.md for the whole GNS3 -> local -> remote -> real chain):
  npf --test examples/docker-web.npf local --cluster client=docker://npf-client server=docker://npf-server
  npf --test examples/docker-web.npf local --tags real netem --cluster client=docker://npf-client
  npf --test examples/docker-web.npf local --gns3 my-project --gns3-start
Scaling out: --gns3-url http://host:3080 for a remote GNS3 server, or client=user@host for real machines.

%config
default_repo=local
n_runs=3
timeout=90
var_names={TTFB:Time to first byte,TOTAL:Total time,CONNECT:Connect time}
var_unit={TTFB:ms,TOTAL:ms,CONNECT:ms,SIZE:bytes}
graph_force_diagonal_labels=1

%variables
FSIZE=32
DELAY=0
RATE=100mbit
real:URL=FILE(docker-testbed/sites.txt)
netem:DELAY={0,20,100}

%-real:script@server autokill=false
dd if=/dev/urandom of=/var/www/html/bin-${FSIZE}K bs=1K count=$FSIZE 2>/dev/null

%script@client jinja delay=1 critical=false timeout=60
{% if netem %}
sudo tc qdisc replace dev eth0 root netem delay ${DELAY}ms
sudo tc qdisc replace dev eth0 handle ffff: ingress
if sudo ip link add ifb0 type ifb 2>/dev/null || ip link show ifb0 > /dev/null 2>&1; then
    sudo ip link set ifb0 up
    sudo tc filter replace dev eth0 parent ffff: protocol all matchall action mirred egress redirect dev ifb0
    sudo tc qdisc replace dev ifb0 root netem rate ${RATE} limit 10000
else
    echo "No ifb device: policing the download to ${RATE} instead of shaping it, the rate is only approximate"
    sudo tc filter replace dev eth0 parent ffff: protocol all u32 match u32 0 0 police rate ${RATE} burst 1m drop flowid :1
fi
{% endif %}
{% if not real %}
URL=http://${server:ip}/bin-${FSIZE}K
{% endif %}
out=$(curl -sS -L -o /dev/null --max-time 45 -A "npf-bench" \
    -w '%{http_code} %{time_connect} %{time_starttransfer} %{time_total} %{size_download}' "$URL")
echo "$URL -> $out"
echo "$out" | awk '$1 >= 200 && $1 < 400 {
    printf "RESULT-CONNECT %.3f\nRESULT-TTFB %.3f\nRESULT-TOTAL %.3f\nRESULT-SIZE %d\n", $2*1000, $3*1000, $4*1000, $5 }'
{% if netem %}
sudo tc qdisc del dev eth0 root || true
sudo tc qdisc del dev eth0 ingress || true
sudo ip link del ifb0 2>/dev/null || true
{% endif %}
